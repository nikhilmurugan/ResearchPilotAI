# ResearchPilotAI — Environment Variables
# No API key needed. Ollama runs locally.

# Optional: override the default Ollama host (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Optional: override the default model (default: qwen2.5-coder:3b)
# OLLAMA_MODEL=qwen2.5-coder:3b

# Required for PDF evidence-grounded Q&A; pull once with: ollama pull nomic-embed-text
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional local web server settings
# FLASK_HOST=127.0.0.1
# FLASK_DEBUG=0
# PORT=5000
